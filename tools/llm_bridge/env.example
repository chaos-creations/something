# /etc/llm-bridge/env, chmod 600, owned by root
STAR_KEY=
STAR_URL=https://ai.starimg.ru
STAR_MODEL=claude-haiku-5-5
# bearer or x-api-key, as reported by check_relay.py
STAR_AUTH=bearer
# set to 0 if check_relay.py says tool use FAIL
STAR_TOOLS=1

# Shared secret with the game server (config LLM_BRIDGE_TOKEN): openssl rand -hex 32
BRIDGE_TOKEN=
# Requests per minute over all NPCs, seconds between requests of one NPC, requests per day
BRIDGE_RPM=60
BRIDGE_BRAIN_COOLDOWN=3
BRIDGE_DAILY=3000
