/datum/equipment_preset/faction_scggcc/soldier_scg
	name = "Bay12 | Human | SCG Soldier"
	idtype = /obj/item/card/id/dogtag
	languages = list(LANGUAGE_ENGLISH) //Let's keep it simple for now
	faction = FACTION_UNITED_HUMANITY
	faction_group = (FACTION_UNITED_HUMANITY)
	skills = /datum/skills/rifleman_pve
	flags = EQUIPMENT_PRESET_EXTRA

/datum/equipment_preset/faction_scggcc/soldier_scg/load_id(mob/living/carbon/human/new_human)
	. = ..()
	new_human.faction = faction
	new_human.faction_group = faction_group

/datum/equipment_preset/faction_scggcc/soldier_scg/load_gear(mob/living/carbon/human/new_human)
	new_human.equip_to_slot_or_del(new /obj/item/storage/backpack/marine/satchel/big, WEAR_BACK)

	var/pick_helmet = pick(1,2)
	switch(pick_helmet)
		if(1)
			new_human.equip_to_slot_or_del(new /obj/item/clothing/head/helmet/faction_scg/tacticool(new_human), WEAR_HEAD)
		if(2)
			new_human.equip_to_slot_or_del(new /obj/item/clothing/head/helmet/faction_scg/tacticool/alt(new_human), WEAR_HEAD)

	if(prob(30))
		new_human.equip_to_slot_or_del(new /obj/item/clothing/under/marine/standard/faction_scg(new_human), WEAR_BODY)
		new_human.equip_to_slot_or_del(new /obj/item/clothing/shoes/marine/knife(new_human), WEAR_FEET)
		new_human.equip_to_slot_or_del(new /obj/item/clothing/gloves/marine/fingerless(new_human), WEAR_HANDS)

		var/obj/item/clothing/suit/storage/marine/faction_scg/armored_plate/M = new()
		var/obj/item/clothing/accessory/poncho/black/W = new()
		M.attach_accessory(new_human, W)
		new_human.equip_to_slot_or_del(M, WEAR_JACKET)
	else
		new_human.equip_to_slot_or_del(new /obj/item/clothing/under/marine/standard/faction_scg(new_human), WEAR_BODY)
		new_human.equip_to_slot_or_del(new /obj/item/clothing/shoes/marine/knife(new_human), WEAR_FEET)
		new_human.equip_to_slot_or_del(new /obj/item/clothing/gloves/marine/fingerless(new_human), WEAR_HANDS)
		new_human.equip_to_slot_or_del(new /obj/item/clothing/suit/storage/marine/faction_scg/armored_plate(new_human), WEAR_JACKET)

	new_human.equip_to_slot_or_del(new /obj/item/weapon/gun/faction_scggcc/rifle, WEAR_J_STORE)
	new_human.equip_to_slot_or_del(new /obj/item/weapon/gun/faction_scggcc/pistol, WEAR_WAIST)

	new_human.equip_to_slot_or_del(new /obj/item/ammo_magazine/faction_scggcc/rifle, WEAR_IN_BACK)
	new_human.equip_to_slot_or_del(new /obj/item/ammo_magazine/faction_scggcc/rifle, WEAR_IN_BACK)
	new_human.equip_to_slot_or_del(new /obj/item/ammo_magazine/faction_scggcc/rifle, WEAR_IN_BACK)
	new_human.equip_to_slot_or_del(new /obj/item/ammo_magazine/faction_scggcc/rifle, WEAR_IN_BACK)
	new_human.equip_to_slot_or_del(new /obj/item/ammo_magazine/faction_scggcc/pistol, WEAR_IN_BACK)

